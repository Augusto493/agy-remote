{
  "name": "agy-remote-desktop",
  "productName": "Agy Remote",
  "version": "1.0.0",
  "description": "Agy Remote: controle o Antigravity do PC pelo celular",
  "main": "main.js",
  "author": "Augusto493",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.agyremote.desktop",
    "productName": "Agy Remote",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "package.json", "build/icon.png"],
    "extraResources": [
      { "from": "../server", "to": "server", "filter": ["**/*", "!data/**"] }
    ],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Agy Remote"
    }
  }
}
